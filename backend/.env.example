# 后端服务配置
# 本机填写 .env；提交 GitHub 时保留空密钥的 .env.example。
# 修改实际配置后，停止并重新启动后端，才会加载新值。
#
# 配置一项服务，需要匹配：接口基础地址（URL）+ 该平台的 Key + 模型名。
# 不同模型不一定用不同 URL：同一平台可共用；换平台时需核对这三项。
# URL 填平台提供的 Base URL，是否包含 /v1 以平台文档为准。
# 不要在 URL 中填写 Key，也不要在 Base URL 后追加 /chat/completions 等完整接口路径。
# 模型名使用该平台实际支持的 ID；转发平台的别名以该平台为准。

# ── 1. 文案服务：生成文案、改写文案、理解图片修改意见 ──
# QWEN_BASE_URL 是历史变量名，也可填写其他 OpenAI 兼容服务的基础地址。
# WORD_API_KEY 填这个地址对应的平台 Key；COPY_MODEL 填文案模型。
# 若保留旧 QWEN_API_KEY，WORD_API_KEY 非空时优先使用 WORD_API_KEY。
QWEN_BASE_URL=https://ws-ehnylndpm63oobsm.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
WORD_API_KEY=
COPY_MODEL=deepseek-v4-pro

# ── 2. 海报解析：识别参考图片的构图、风格和配色 ──
# 当前代码共用第 1 组的 URL 和 Key；VISION_MODEL 必须是该平台支持的看图模型。
# 当前未读取 VISION_BASE_URL / VISION_API_KEY，单独添加这两个变量不会生效。
VISION_MODEL=qwen3-vl-plus

# ── 3. 图片生成服务 ──
# 三项分别填写生图平台的 URL、Key 和生图模型，不能只替换模型名。
# 与文案使用同一平台时，两个 URL 可以相同。
# IMAGE_BASE_URL 留空会沿用 QWEN_BASE_URL；IMAGE_API_KEY 不会自动沿用文字 Key。
# IMAGE_API_KEY 未配置时显示演示占位图。
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=qwen-image-3.0-pro

# ── 4. RAG 向量服务（Embedding） ──
# 填写支持 Embedding 的平台 URL、该平台的 Key、Embedding 模型与向量维度。
# EMBED_BASE_URL 留空会沿用 QWEN_BASE_URL；Key 和模型名缺少任一项时只用本地关键词检索。
# EMBEDDING_API_KEY 是兼容旧变量名；EMBED_API_KEY 非空时优先使用 EMBED_API_KEY。
# 已有向量库需要匹配生成它的模型和维度；更换模型或维度通常需要重建索引。
# 只填写 Key 不会自动补齐已有数据库中缺失的向量。
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
EMBED_DIMENSIONS=1024

# ── 5. 演示模式 ──
# true：强制文案、海报解析和生图使用演示；空值或 false：按各组 Key 判断。
# 这个开关不控制 Embedding 调用；Embedding 是否调用由第 4 组配置决定。
USE_MOCK=
# 仅明确设置 true 时向空旧产品库写入示例；生产环境保持 false。
SEED_DEMO_DATA=false

# ── 6. 应用访问与生成额度 ──
# 下面两个是应用密码，不是模型 Key；APP_ACCESS_KEY 留空表示不启用访问密码。
# 新版接口会校验此访问密码；旧生成接口仍保留原来的处理方式。
# ADMIN_RESET_KEY 用于管理员重置额度，留空则不能通过管理接口重置。
# 额度是现有累计次数上限，不会按天自动刷新。
APP_ACCESS_KEY=
ADMIN_RESET_KEY=
QUOTA_PER_USER=7
QUOTA_TOTAL=50

# ── 7. 品牌知识库 ──
# 留空时使用 backend/data/brand-knowledge.db（仅本地开发）。
# PostgreSQL 示例：postgresql+psycopg://用户名:密码@127.0.0.1:5432/数据库名
# PostgreSQL 需预先安装 pgvector，并允许数据库执行 CREATE EXTENSION vector。
BRAND_DATABASE_URL=
# 留空时原文件保存在 backend/data/brand-files；生产环境应使用持久化存储和备份。
BRAND_STORAGE_DIR=
# ── 9. 营销素材 ──
# 实拍海报需要支持中文的字体。Windows 自动查找微软雅黑；Linux 可指定 Noto Sans CJK。
BRAND_FONT_PATH=
# AI 图片 URL 持久保存的可信域名，逗号分隔；仅允许 HTTPS、公网地址，不跟随重定向。
# 例如供应商实际返回的 OSS 图片域名。返回 Base64 图片时无需设置。
BRAND_IMAGE_ALLOWED_HOSTS=

# 可选：独立数据库和资料目录；留空保持 backend/data。
APP_DATA_DIR=
# 当前是共享工作空间；默认仅允许本机访问，无账号、会话和成员权限。
WORKSPACE_LOCAL_ONLY=true
