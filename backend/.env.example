# ===== 千问 / 通义万相（阿里云百炼 MaaS，OpenAI 兼容协议）=====
# 专属端点（OpenAI 兼容）
QWEN_BASE_URL=https://ws-ehnylndpm63oobsm.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# API key
QWEN_API_KEY=

# 生图模型（通义万相 3.0 Pro）
IMAGE_MODEL=qwen-image-3.0-pro

# 反向解析模型（多模态视觉）
VISION_MODEL=qwen3-vl-plus

# 文案生成模型（DeepSeek）
COPY_MODEL=deepseek-v4-pro

# 为 true 时强制 mock（无 key 时自动 mock）
USE_MOCK=

# ===== 线上访问控制 =====
# 访问密码（为空则不启用密码校验）
APP_ACCESS_KEY=
# 管理员重置密钥（重置额度用，只有管理员知道）
ADMIN_RESET_KEY=
# 额度限制：每人最多次数 / 总共最多次数
QUOTA_PER_USER=7
QUOTA_TOTAL=50
