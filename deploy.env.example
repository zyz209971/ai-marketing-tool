# Copy to .env.deploy (gitignored). These are placeholders, never real credentials.
DB_PASSWORD=replace-with-a-random-database-password
AGENT_API_KEY=
AGENT_BASE_URL=https://openrouter.ai/api/v1
AGENT_MODEL=z-ai/glm-5.3-flash
QWEN_BASE_URL=https://openrouter.ai/api/v1
COPY_MODEL=z-ai/glm-5.3-flash
# Real models require USE_MOCK=false and a valid key. Blank embeddings use text retrieval.
USE_MOCK=true
EMBED_API_KEY=
EMBED_MODEL=
COOKIE_SECURE=false
ALLOW_LOCAL_HTTP=true
